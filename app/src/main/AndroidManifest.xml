<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      The 10-day app blockade should survive the app being uninstalled and reinstalled. App-private
      storage is wiped on uninstall, so uninstall-survival is best-effort via Android Auto Backup:
      the internal ledger (blockade.json) is included in cloud backup (see @xml/backup_rules and
      @xml/data_extraction_rules) and restored on reinstall, keyed to the user's Google account. This
      requires no runtime permission.

      The 鍛錬 training history (exercise.db) is included in the same two rule files, main database
      file only. A year of training is worth restoring, and there is nothing sensitive in it.
      鍛錬 adds no component and no service: the session player keeps the screen on with
      FLAG_KEEP_SCREEN_ON, derives its timeline from a monotonic clock, and is therefore correct on
      return from the background without a foreground service (03-player.md §E.5). It adds exactly one
      permission, VIBRATE, declared below.
    -->

    <!--
      The session player's haptic channel: a pulse at each phase change, so a countdown can be felt
      through a pocket rather than watched. VIBRATE is a normal install-time permission — it is granted
      at install, there is no runtime prompt and no user-visible ceremony, which is why it does not
      engage 03-player.md §E.5's Phase-1 refusal of runtime and foreground-service entries. Vibrator
      calls are unconditional in GymHaptics, so without this the whole channel is silently inert and
      lint fails with MissingPermission.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      The 予定 page reads the device's calendar through CalendarContract — the same provider the
      Google Calendar sync adapter writes into, so Tempo shows the very agenda the user's other
      devices show, with no OAuth, no network and no Play Services. WRITE lets the composer add and
      edit an event in place; the change is picked up by the sync adapter and pushed back to Google.
      Both are requested at the moment the user opens the page, never at launch.
    -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!--
      A home app legitimately needs to see every launchable app to populate Search.
      The launcher intent below grants that visibility on Android 11+ without QUERY_ALL_PACKAGES.
      The second entry lets Tempo hand a repeating event off to the system calendar app, which is the
      only place recurrence is safe to edit.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="vnd.android.cursor.item/event" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Tempo">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Surfaces real notifications to the 通知 screen once the user grants access. -->
        <service
            android:name=".notification.TempoNotificationListener"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>

</manifest>
